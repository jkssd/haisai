+   * any_active 为 0；提前 return -1 会让连接永远停在 checking。 */
+
   for (i = 0; i < agent->active_pairs_count; i++) {
     if (agent->active_pairs[i]->state == ICE_CANDIDATE_STATE_SUCCEEDED) {
       agent->selected_pair = agent->active_pairs[i];
