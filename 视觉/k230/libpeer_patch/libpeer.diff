--- a/port/modules/modwebrtc.c
+++ b/port/modules/modwebrtc.c
@@ -27,6 +27,19 @@
 
 #include "peer.h"
 
+#include <stdarg.h>
+
+/* libpeer 的 fprintf(stdout) 在 RT-Smart 下到不了串口，统一走 MicroPython 控制台。 */
+void peer_log(char* level_tag, const char* file_name, int line_number,
+              const char* fmt, ...) {
+    char buf[280];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    mp_printf(&mp_plat_print, "[%s] %s:%d %s\n", level_tag, file_name, line_number, buf);
+}
