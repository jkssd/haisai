+      for (i = 0; i < agent->active_pairs_count; i++) {
+        int st = agent->active_pairs[i]->state;
+        if (st == ICE_CANDIDATE_STATE_INPROGRESS) _ip++;
+        else if (st == ICE_CANDIDATE_STATE_SUCCEEDED) _succ++;
+        else if (st == ICE_CANDIDATE_STATE_FAILED) _fail++;
+      }
+      LOGI("PROBE chk #%d pairs=%d inprog=%d succ=%d fail=%d any_active=%d",
